---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- 글 전용 사이트맵. 기본 sitemap.xml 이 2024-10-13 이후 구글에 재수집되지 않아
     (GSC 상태 isPending) 새 경로로 다시 제출하기 위해 추가했다. 기본 sitemap.xml 은 그대로 둔다. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
{% assign sorted = site.posts | sort: 'date' | reverse %}{% for post in sorted %}  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
    <lastmod>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
  </url>
{% endfor %}</urlset>
